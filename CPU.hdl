// and the book "The Elements of Computing Systems"
// by Nisan and Schocken, MIT Press.
// File name: capstone/CPU.hdl

/**
 * The Hack CPU (Central Processing unit), consisting of an ALU,
 * two registers named A and D, and a program counter named PC.
 * The CPU is designed to fetch and execute instructions written in 
 * the Hack machine language. In the case of a C-instruction, attempts to
 * read the inM input (M value), to write into the inM input (writeM),
 * to write into the outM output (outM), and to set the addressM output.
 * In the case of an A-instruction, attempts to set the addressM output.
 */

CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
    // Instruction decoding:
    // A-instruction: instruction[15] == 0
    // C-instruction: instruction[15] == 1
    Not(in=instruction[15], out=isA);
    Not(in=isA, out=isC);

    // Mux before A-Register:
    // If A-instruction, load instruction directly into A.
    // If C-instruction, load ALU output if destination bit d1 (instruction[5]) is 1.
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aRegIn);
    And(a=isC, b=instruction[5], out=loadAFromC);
    Or(a=isA, b=loadAFromC, out=loadA);
    ARegister(in=aRegIn, load=loadA, out=aRegOut, out[0..14]=addressM);

    // Select A or M into ALU y-input based on bit a (instruction[12])
    Mux16(a=aRegOut, b=inM, sel=instruction[12], out=aluY);

    // D-Register: loaded if C-instruction and destination bit d2 (instruction[4]) is 1
    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dRegOut);

    // ALU execution:
    // Control bits: instruction[11..6] -> zx, nx, zy, ny, f, no
    ALU(x=dRegOut, y=aluY,
        zx=instruction[11],
        nx=instruction[10],
        zy=instruction[9],
        ny=instruction[8],
        f=instruction[7],
        no=instruction[6],
        out=aluOut,
        out=outM,
        zr=zrOut,
        ng=ngOut);

    // Write to M: only in C-instruction and if d3 (instruction[3]) is 1
    And(a=isC, b=instruction[3], out=writeM);

    // Jump conditions evaluation:
    // ngOut: result < 0
    // zrOut: result == 0
    // isPos: result > 0 (not negative and not zero)
    Or(a=zrOut, b=ngOut, out=notPos);
    Not(in=notPos, out=isPos);

    And(a=instruction[2], b=ngOut, out=jumpNg);   // j1: jump if < 0
    And(a=instruction[1], b=zrOut, out=jumpZr);   // j2: jump if == 0
    And(a=instruction[0], b=isPos, out=jumpPos);  // j3: jump if > 0

    Or(a=jumpNg, b=jumpZr, out=jumpNgOrZr);
    Or(a=jumpNgOrZr, b=jumpPos, out=jumpMatch);

    // Jump occurs only if it's a C-instruction and condition matched
    And(a=isC, b=jumpMatch, out=pcLoad);
    Not(in=pcLoad, out=pcInc);

    // Program Counter:
    PC(in=aRegOut, load=pcLoad, inc=pcInc, reset=reset, out[0..14]=pc);
}
